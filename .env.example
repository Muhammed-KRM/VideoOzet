# Video Özet Sistemi — Environment Variables
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun.
# .env dosyası GIT'E GÖNDERİLMEZ (.gitignore'da tanımlı).

# Veritabanı (PostgreSQL + pgvector)
DB_PASSWORD=postgres

# API Güvenlik Anahtarı (X-API-Key)
ADMIN_API_KEY=SUPER_SECRET_API_KEY_123!

# AI API Anahtarları
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# Model İsimleri (Dinamik Yönetim)
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_MODEL=claude-3-5-sonnet-20240620
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=whisper-1

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
